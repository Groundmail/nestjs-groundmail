{
  "name": "nestjs-groundmail",
  "version": "0.1.7",
  "description": "NestJS module for Groundmail: inject a ready Groundmail client anywhere in your app",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Groundmail/nestjs-groundmail.git"
  },
  "homepage": "https://docs.groundmail.dev/frameworks/nestjs",
  "bugs": {
    "url": "https://github.com/Groundmail/nestjs-groundmail/issues"
  },
  "keywords": [
    "nestjs",
    "nest",
    "nestjs-module",
    "email",
    "mail",
    "mailer",
    "transactional-email",
    "groundmail"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0"
  },
  "dependencies": {
    "groundmail": ">=0.14.5 <1.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/testing": "^12.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --target node18 --external groundmail --clean",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  }
}
